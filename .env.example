# Copy this file to .env (or .env.local for `vercel dev`) and fill in real
# values. Never commit the real .env file — it's already in .gitignore.

# Slack Incoming Webhook URL for the #contact-form channel.
# Create at https://api.slack.com/apps -> your app -> Incoming Webhooks.
SLACK_WEBHOOK_URL=

# Resend API key used to email contact-form submissions to info@4ccs.com.
# Create at https://resend.com -> Dashboard -> API Keys.
RESEND_API_KEY=

# Optional: verified "from" address for outgoing email, e.g.
# "4C Construction System <notifications@4ccs.com>". Requires verifying the
# sending domain in Resend. If unset, falls back to Resend's sandbox sender,
# which works for testing but has production limitations.
EMAIL_FROM=
