# Apache config for the Bluehost-hosted static site. This REPLACES the
# WordPress site's previous .htaccess entirely -- this project ships no
# WordPress and needs none of its rewrite rules or caching-plugin
# (SpeedyCache) block. Mirrors vercel.json's rewrites and headers -- if
# either changes for a URL or caching rule, check the other one too.
#
# The Partner Application form's Slack/email relay (api/submit-form.js)
# stays on Vercel and is never requested on this domain at all -- the
# browser posts straight to
# https://construction-system-sage.vercel.app/api/submit-form
# (see assets/js/main.js). Nothing below touches /api/ in any way.

RewriteEngine On

# ---------- Alias domain -> primary domain ----------
# 4cconstructionsystems.com (with or without www) has always forwarded to
# 4ccs.com. Made explicit here so it keeps working regardless of how it was
# wired before (Bluehost domain forwarding and/or something WordPress-side),
# which goes away with the WordPress install. Goes straight to the
# canonical https://4ccs.com form below rather than bouncing through it as a
# second redirect.
RewriteCond %{HTTP_HOST} ^(?:www\.)?4cconstructionsystems\.com$ [NC]
RewriteRule ^ https://4ccs.com%{REQUEST_URI} [R=301,L]

# ---------- Canonical host: force https + non-www ----------
# Production canonical is https://4ccs.com (no www). Matches that form's
# canonical URLs, og:url values, and sitemap.xml entries declared across
# every page. Without this, the same page reachable at http://,
# https://www.4ccs.com, and https://4ccs.com would read as three separate
# URLs to search engines.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.4ccs\.com$ [NC]
RewriteRule ^ https://4ccs.com%{REQUEST_URI} [R=301,L]

# ---------- Pretty URLs -> the real .html files ----------
# Internal rewrite, not a redirect -- the address bar keeps showing e.g.
# /borrego-springs while Apache actually serves borrego-springs.html,
# matching vercel.json's rewrites and how these are listed in sitemap.xml.
RewriteRule ^altadena-residence/?$ /altadena-residence.html [L]
RewriteRule ^borrego-springs/?$ /borrego-springs.html [L]
RewriteRule ^escondido/?$ /escondido.html [L]
RewriteRule ^rialto/?$ /rialto.html [L]

# ---------- Caching (matches vercel.json's headers block) ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpe?g|png|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>
</IfModule>

# ---------- Don't expose directory contents ----------
Options -Indexes
