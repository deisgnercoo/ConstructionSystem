# Apache config for the Bluehost-hosted static site. Mirrors vercel.json --
# when either file changes for a URL/caching rule, check the other one too.
#
# Bluehost (Apache + mod_rewrite) has no equivalent to Vercel's "rewrites"
# config, so the pretty URLs (e.g. /borrego-springs) that vercel.json handles
# there are reproduced here as internal rewrites: the address bar keeps
# showing /borrego-springs while Apache actually serves borrego-springs.html.
# The form submission endpoint itself is unaffected by any of this -- it
# stays on Vercel (see assets/js/main.js and api/submit-form.js) since
# Bluehost is static-only and can't run that serverless function.

# ---------- Canonical host: force https + www ----------
# Matches the https://www.4ccs.com/... canonical URLs and og:url values
# already declared on every page. Without this, the same page reachable at
# http://, https://4ccs.com, and https://www.4ccs.com would read as three
# separate URLs to search engines.
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://www.%1%{REQUEST_URI} [R=301,L]

# ---------- Pretty URLs -> the real .html files ----------
RewriteRule ^altadena-residence/?$ /altadena-residence.html [L]
RewriteRule ^borrego-springs/?$ /borrego-springs.html [L]
RewriteRule ^escondido/?$ /escondido.html [L]
RewriteRule ^rialto/?$ /rialto.html [L]

# ---------- Caching (matches vercel.json's headers block) ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpe?g|png|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>
</IfModule>

# ---------- Don't expose directory contents ----------
Options -Indexes
